{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/discover",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/monitor",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/revival",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/verify-pipeline",
      "schedule": "30 20 5 11 *"
    }
  ],
  "functions": {
    "api/cron/verify-pipeline.js": {
      "maxDuration": 300
    }
  }
}
