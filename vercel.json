{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/discover",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/monitor",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/cron/revival",
      "schedule": "0 22 * * *"
    }
  ]
}
